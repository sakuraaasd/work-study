const { chromium } = require('playwright');

(async () => {
    const browser = await chromium.launch({ headless: true }); // 为了调试，将headless设置为true
    const context = await browser.newContext({ storageState: 'auth.json' }); 
    const page = await context.newPage();
    
    // 请替换为Excel Online的URL（.xlsx文件）
    await page.goto('https://fsio365.sharepoint.com/:x:/r/sites/PLATON4D/_layouts/15/Doc.aspx?sourcedoc=%7B3A2998AC-990A-4BA7-B82D-619DBA97F32D&file=Book2.xlsx&action=default&mobileredirect=true');
    
    // 等待Excel加载完成
    await page.waitForTimeout(8000); // Excel Online加载较慢
    
    const aLinks = [];
    
    // 读取前提是139行（可根据需要调整）
    for (let i = 0; i < 139; i++) {
        // 选择A列的单元格
        await page.click(`[aria-label="A${i + 1}"]`);
        
        // 获取当前单元格的内容（包括超链接）
        const cellContent = await page.evaluate(() => {
            const selection = document.querySelector('[aria-selected="true"]');
            return selection ? selection.innerText : '';
        });
        
        // 提取 .aspx超链接
        const match = cellContent.match(/https:\/\/[^"]+\.aspx/);
        if (match) {
            aLinks.push(match[0]);
        }
        
        await page.waitForTimeout(500); // 等待渲染
    }
    
    // 显示A列的所有 .aspx超链接
    console.log('\nA列的 .aspx超链接如下:');
    aLinks.forEach(link => console.log(link));
    
    await browser.close();
    console.log('浏览器已关闭');
})();

